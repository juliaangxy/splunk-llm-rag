# Secrets for the AIRGAPPED environment. Copy to airgapped.env and fill in real
# values. airgapped.env is git-ignored and read by deploy.sh, which pushes these
# into AWS Secrets Manager (secret id: splunk-ai/airgapped). They are NEVER passed
# as CloudFormation parameters.

# --- Secrets (pushed into Secrets Manager) ---
export SPLUNK_ADMIN_PASSWORD='ChangeThisToAStrongPassword!'
export SPLUNK_HEC_TOKEN=''            # optional; generated if left blank (token_metrics HEC)
export PROXY_API_KEY=''               # optional; generated if left blank (token-meter proxy bearer key)
export HF_TOKEN=''                    # optional; NOT needed for the default ungated models. Only set if you switch VllmModel to a gated repo (used only at staging time).

# --- Operator inputs (mandatory, not stored as secrets) ---
# The airgapped instances still expose 22/8000 to you for convenience.
export ALLOWED_SSH_CIDR='203.0.113.10/32'
export ALLOWED_SPLUNK_UI_CIDR='203.0.113.10/32'

# --- Optional overrides ---
# export RESOURCE_NAME_PREFIX='splunk-ai'
# export VPC_CIDR='10.0.0.0/16'
# export PUBLIC_SUBNET_CIDR='10.0.1.0/24'
