# Secrets for the CLOUD environment. Copy to cloud.env and fill in real values.
# cloud.env is git-ignored and read by deploy.sh, which pushes these into AWS
# Secrets Manager (secret id: splunk-ai/cloud). They are NEVER passed as
# CloudFormation parameters.
#
# Also holds deploy-time operator inputs that are not secrets but are required.

# --- Secrets (pushed into Secrets Manager) ---
export SPLUNK_ADMIN_PASSWORD='ChangeThisToAStrongPassword!'
export SPLUNK_HEC_TOKEN=''            # optional; generated if left blank (token_metrics HEC)
export PROXY_API_KEY=''               # optional; generated if left blank (token-meter proxy bearer key)
export HF_TOKEN=''                    # optional; NOT needed for the default ungated models. Only set if you switch VllmModel to a gated repo.

# --- Operator inputs (mandatory, not stored as secrets) ---
# CIDRs allowed to reach SSH (22) and Splunk Web (8000). Use /32 for a single IP.
export ALLOWED_SSH_CIDR='203.0.113.10/32'
export ALLOWED_SPLUNK_UI_CIDR='203.0.113.10/32'

# --- Optional overrides ---
# export RESOURCE_NAME_PREFIX='splunk-ai'
# export VPC_CIDR='10.0.0.0/16'
# export PUBLIC_SUBNET_CIDR='10.0.1.0/24'
# export SPLUNK_PACKAGE_URL='https://download.splunk.com/products/splunk/releases/10.4.1/linux/splunk-10.4.1-5a009d941268.x86_64.rpm'
