# MCP server deployment config — copy to mcp.env and edit, then run: bash mcp/deploy-mcp.sh
# Every UPPER/CamelCase name below maps to a CloudFormation parameter (or a deploy setting).
# Leave a line commented/blank to use the template default.

# ---- deploy target ------------------------------------------------------------------------
REGION=ap-southeast-1                    # region the MCP EC2 stack is created in (your Splunk VPC region)
STACK_NAME=mcp-server

# ---- networking (a NEW subnet is always created for the MCP server) -----------------------
# All four below are AUTO-RESOLVED from your VPC when left blank — uncomment only to override:
#   ExistingVpcId  <- foundation stack 'VpcId' output, else a VPC tagged Name=splunk-ai-vpc
#   ExistingIgwId  <- the internet gateway attached to that VPC
#   SplunkCidr     <- the VPC CIDR (whole VPC may reach the port)
#   SubnetCidr     <- the highest free /24 in the VPC
# ExistingVpcId=vpc-0123456789abcdef0
# ExistingIgwId=igw-0123456789abcdef0
# SubnetCidr=10.0.250.0/24
# SplunkCidr=10.0.1.0/24
PLATFORM_NET_STACK=splunk-ai-foundation-network   # stack used to auto-resolve the VPC
AllowInternetAccess=false                # true also opens the port to 0.0.0.0/0 and attaches an Elastic IP
McpPort=8000

# ---- load balancer (recommended when AITK agents use this MCP) -------------------------------
# A raw EC2 IP can't serve both sides: in-VPC clients (the Splunk search head doing AITK tool
# enumeration) can only reach the PRIVATE IP, while Bedrock AgentCore (agent runtime, outside the
# VPC) can only reach a PUBLIC endpoint. CreateLoadBalancer stands up an internet-facing NLB (TCP
# passthrough, keeps the server's TLS) that BOTH can reach; use its McpLoadBalancerEndpoint output
# as the custom MCP connection URL. AgentLaunchpadCidr is your region's Agent Launchpad egress /32.
CreateLoadBalancer=false                 # true = create the NLB + LB SG + listener + private-DNS override
# The LB must allow your AGENT LAUNCHPAD egress IP, which is set by your CLOUD CONNECT region — this is
# OFTEN NOT the deployment REGION above. (E.g. Splunk in ap-southeast-1 but Cloud Connect in us-east-1
# => the LB must allow the us-east-1 IP.) Set CloudConnectRegion; the IP is looked up from
# utils/agentcore-region-ips.tsv (refresh with utils/fetch-agentcore-ips.sh).
# CloudConnectRegion=us-east-1           # region where AITK Cloud Connect / the agent runtime runs
# AgentLaunchpadCidr=1.2.3.4/32          # OR set the egress /32 explicitly (overrides the lookup)
# Optional: also front Splunk's OWN MCP (self_mcp, splunk_run_query) through the same NLB on :8089.
# Set the instance running it (search head / GPU); its SG auto-resolves if you leave the SG blank.
# SplunkMcpInstanceId=i-0123456789abcdef0
# SplunkMcpSecurityGroupId=sg-0123456789abcdef0   # optional; auto-resolved from the instance
# SplunkMcpPort=8089

# ---- Bedrock knowledge base -----------------------------------------------------------------
BedrockRegion=us-east-1                  # region the KB lives in (can differ from REGION)
# BedrockKnowledgeBaseId=XXXXXXXXXX      # leave blank to AUTO-DISCOVER by name (deploy-mcp.sh --discover-kb, on by default)
KB_NAME=splunk-ai-kb                     # name used for auto-discovery when the id is blank

# ---- web search -----------------------------------------------------------------------------
WebSearchProvider=searxng                # searxng | duckduckgo | tavily | brave | none
# WebSearchApiKey=                       # required only for tavily/brave
# SearxngUrl=                            # leave blank to install SearXNG on the instance (needs t3.medium)

# ---- server code (private repo -> instance pulls it from S3 via its role) -------------------
CodeS3Bucket=mcp-code-123456789012       # bucket holding mcp_server.py + requirements.txt
CodeS3Prefix=mcp-server

# ---- instance (POC-sized for cost) ----------------------------------------------------------
InstanceType=t3.small                    # ~US$15/mo on-demand; use t3.medium if SearxngUrl is blank (SearXNG runs on-box)
TlsMode=self-signed                      # self-signed | none
# KeyName=my-ec2-key                     # optional SSH key pair name
