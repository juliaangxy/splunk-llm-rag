# MCP server deployment config — copy to mcp.env and edit, then run: bash mcp/deploy-mcp.sh
# Every UPPER/CamelCase name below maps to a CloudFormation parameter (or a deploy setting).
# Leave a line commented/blank to use the template default.

# ---- deploy target ------------------------------------------------------------------------
REGION=ap-southeast-1                    # region the MCP EC2 stack is created in (your Splunk VPC region)
STACK_NAME=mcp-server

# ---- networking (a NEW subnet is always created for the MCP server) -----------------------
# All four below are AUTO-RESOLVED from your VPC when left blank — uncomment only to override:
#   ExistingVpcId  <- foundation stack 'VpcId' output, else a VPC tagged Name=splunk-ai-vpc
#   ExistingIgwId  <- the internet gateway attached to that VPC
#   SplunkCidr     <- the VPC CIDR (whole VPC may reach the port)
#   SubnetCidr     <- the highest free /24 in the VPC
# ExistingVpcId=vpc-02987ff7a1db5f001
# ExistingIgwId=igw-0cbb1d6c98334303c
# SubnetCidr=10.0.250.0/24
# SplunkCidr=10.0.1.0/24
PLATFORM_NET_STACK=splunk-ai-foundation-network   # stack used to auto-resolve the VPC
AllowInternetAccess=false                # true also opens the port to 0.0.0.0/0 and attaches an Elastic IP
McpPort=8000

# ---- Bedrock knowledge base -----------------------------------------------------------------
BedrockRegion=us-east-1                  # region the KB lives in (can differ from REGION)
# BedrockKnowledgeBaseId=NOLACZ9Y0T      # leave blank to AUTO-DISCOVER by name (deploy-mcp.sh --discover-kb, on by default)
KB_NAME=splunk-ai-kb                     # name used for auto-discovery when the id is blank

# ---- web search -----------------------------------------------------------------------------
WebSearchProvider=searxng                # searxng | duckduckgo | tavily | brave | none
# WebSearchApiKey=                       # required only for tavily/brave
# SearxngUrl=                            # leave blank to install SearXNG on the instance (needs t3.medium)

# ---- server code (private repo -> instance pulls it from S3 via its role) -------------------
CodeS3Bucket=mcp-code-618246141311       # bucket holding mcp_server.py + requirements.txt
CodeS3Prefix=mcp-server

# ---- instance (POC-sized for cost) ----------------------------------------------------------
InstanceType=t3.small                    # ~US$15/mo on-demand; use t3.medium if SearxngUrl is blank (SearXNG runs on-box)
TlsMode=self-signed                      # self-signed | none
# KeyName=my-ec2-key                     # optional SSH key pair name
